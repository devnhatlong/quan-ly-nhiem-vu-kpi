PORT=8090

# Database
DB_HOST=127.0.0.1
DB_PORT=27017
DB_USERNAME=
DB_PASSWORD=
DB_NAME=quan_ly_nhiem_vu_kpi
DB_AUTH_SOURCE=admin

# JWT Access Token
JWT_SECRET=
JWT_EXPIRES_IN=1h

# JWT Refresh Token
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Số phiên đăng nhập tối đa của một tài khoản
MAX_SESSIONS_PER_USER=60

# OnlyOffice Document Server (Docker)
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8082
ONLYOFFICE_FILE_BASE_URL=http://host.docker.internal:8090

# Chạy thử qua HTTP trên IP mạng LAN thì bật dòng dưới
# COOKIE_SECURE=false
